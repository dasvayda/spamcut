{
  "name": "spamguard-backend",
  "version": "0.1.0",
  "description": "SpamGuard backend - crowd-sourced SMS spam filter",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node -e \"require('./dist/db/migrate')\"",
    "db:migrate:dev": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "firebase-admin": "^14.0.0",
    "ioredis": "^5.11.1",
    "nanoid": "^3.3.7",
    "pg": "^8.12.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
