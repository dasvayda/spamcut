DATABASE_URL=postgresql://user:password@localhost:5432/spamguard
JWT_SECRET=replace_with_64_char_random_string
PORT=3000
NODE_ENV=development

# Redis (선택) — 없으면 PostgreSQL 직접 조회로 폴백
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK (선택) — FCM 푸시 알림에 필요
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 후 base64 인코딩
# base64 encoding: cat service-account.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT=
