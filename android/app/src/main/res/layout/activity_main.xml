<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="잔액: — token"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvSubscriptionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="구독 상태를 불러오는 중…"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvOverlayStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <!-- 주 진입점 — 수신 번호가 자동으로 쌓이는 목록 -->
    <Button
        android:id="@+id/btnRecent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recent_title"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="번호 직접 신고하기"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnWallet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="지갑 · 구독"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnGrantOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="오버레이 권한 허용"/>

</LinearLayout>
